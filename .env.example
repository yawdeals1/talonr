# Redis connection, used by BullMQ for the scrape job queue.
REDIS_URL=redis://localhost:6379

# Auth — Deploro Auth-as-a-Service (platform Worker hosting /auth/:slug/*)
DEPLORO_AUTH_BASE_URL=https://gallium-worker.calebmensah.workers.dev
DEPLORO_PROJECT_SLUG=talonr

# Database — Deploro's Studio DB REST API (never a direct Postgres connection).
# DEPLORO_STUDIO_API_TOKEN is a project-scoped PAT: deploro token create <name> --project talonr
DEPLORO_STUDIO_API_URL=https://gallium-worker.calebmensah.workers.dev/api/projects/<project-id>/studio
DEPLORO_STUDIO_API_TOKEN=changeme-deploro-pat

# Session/proxy encryption key: 32 raw bytes, base64-encoded.
# Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=changeme-base64-32-bytes

# Cloudflare Turnstile secret for the "talonr-register" widget (registration form only).
# Sitekey is public and lives in frontend/src/lib/config.ts / VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET=changeme-turnstile-secret

# HTTP server
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://localhost:5199

# Worker / scrape tuning
WORKER_CONCURRENCY=5
DEFAULT_DAILY_SCRAPE_LIMIT=150
DEFAULT_MAX_CONCURRENCY_PER_ACCOUNT=1
SCRAPE_CAP_LEADS_DEFAULT=150
SCROLL_DELAY_MIN_MS=1500
SCROLL_DELAY_MAX_MS=4000
PROFILE_DELAY_MIN_MS=2500
PROFILE_DELAY_MAX_MS=6000
