# Postgres connection (Deploro-hosted instance). Never commit real credentials.
DATABASE_URL=postgres://user:pass@host:5432/talonr

# Redis connection, used by BullMQ for the scrape job queue.
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=changeme-generate-a-long-random-string

# Session/proxy encryption key: 32 raw bytes, base64-encoded.
# Generate with: openssl rand -base64 32
SESSION_ENCRYPTION_KEY=changeme-base64-32-bytes

# HTTP server
PORT=3000
NODE_ENV=development
COOKIE_SECURE=false
ALLOWED_ORIGIN=http://localhost:5173

# Worker / scrape tuning
WORKER_CONCURRENCY=5
DEFAULT_DAILY_SCRAPE_LIMIT=150
DEFAULT_MAX_CONCURRENCY_PER_ACCOUNT=1
SCRAPE_CAP_LEADS_DEFAULT=150
SCROLL_DELAY_MIN_MS=1500
SCROLL_DELAY_MAX_MS=4000
